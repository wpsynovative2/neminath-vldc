# Copy to .env.local. These are BUILD-TIME values baked into the static site (both are public).
# On Hostinger's Git build, add them as environment variables in the build settings instead.

# reCAPTCHA v3 site key — https://www.google.com/recaptcha/admin
# This is the key the live WordPress site uses. Add "localhost" to its domains to test locally.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lc3BPAsAAAAAEcnbPqDd063i4kPNqZYWWeBGHjZ

# Google Apps Script web app URL (ends in /exec) — see google-apps-script/Code.gs.
# The reCAPTCHA SECRET key goes in the Apps Script's Script Properties, never here.
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=
