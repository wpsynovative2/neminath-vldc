# Copy to .env.local and fill in.

# reCAPTCHA v3 — https://www.google.com/recaptcha/admin
# This is the site key the live WordPress site uses. Add "localhost" to its
# domain list in the reCAPTCHA admin console to test locally.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lc3BPAsAAAAAEcnbPqDd063i4kPNqZYWWeBGHjZ
# Secret key for the same site key (server only — never prefix with NEXT_PUBLIC_).
RECAPTCHA_SECRET_KEY=
# Submissions scoring below this are rejected (0.0 = bot, 1.0 = human).
RECAPTCHA_MIN_SCORE=0.5

# Google Apps Script web app URL (see google-apps-script/Code.gs). Server only.
GOOGLE_SCRIPT_URL=
